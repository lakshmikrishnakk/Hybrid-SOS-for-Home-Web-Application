# Hybrid SOS Backend Environment Configuration
PORT=5000

# MongoDB Connection String (Replace with your local URI or MongoDB Atlas URI)
# Example Local: mongodb://127.0.0.1:27017/hybrid-sos
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hybrid-sos?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hybrid-sos

# JWT Secret for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
